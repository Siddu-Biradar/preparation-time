{
  "two-sum-ii-input-array-is-sorted": "<span style=\"font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><font color=\"#262626\">\nvar twoSum = function (numbers, target) {\n    let left = 0;\n    let right = numbers.length - 1;\n    while (left &lt; right) {\n        const sum = numbers[left] + numbers[right];\n        if (sum === target) {\n            return [left + 1, right + 1];\n        } else if (sum &gt; target) {\n            right--; </font><b style=\"\"><font color=\"#e74c3c\"> // remove right most element as sum became more than target</font></b><font color=\"#262626\">\n        } else {\n            left++;</font><b style=\"\"><font color=\"#e74c3c\"> // r</font></b></span><span style=\"font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><b style=\"\"><font color=\"#e74c3c\">emove left most element as sum became less than target</font></b></span><span style=\"color: rgb(38, 38, 38); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\">\n        }\n    }\n};</span>",
  "valid-palindrome": "<span style=\"color: rgb(38, 38, 38); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\">\nvar isPalindrome = function (s) {\n    let formatedS = s.toLowerCase().replace(/[^a-z0-9]/g, '');  </span><span style=\"font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><font color=\"#e74c3c\"><b>// Convert everything into lowercase without space</b></font></span><span style=\"font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><font color=\"#262626\">\n\n    let left = 0;\n    let right = formatedS.length - 1;\n\n    while (left &lt; right) { </font><b style=\"\"><font color=\"#e74c3c\">// Shouldn't be equal because its comparing self with itself</font></b><font color=\"#262626\">\n        if (formatedS[left] !== formatedS[right]) {\n            return false\n        }\n        left++\n        right--\n    }\n    return true\n};</font></span>",
  "remove-duplicates-from-sorted-array": "<div><div style=\"caret-color: rgba(0, 0, 0, 0.847); font-family: -apple-system-font; font-size: 12px; white-space: normal;\"><span style=\"color: rgb(38, 38, 38); font-family: -apple-system, system-ui, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\">\nvar removeDuplicates = function(nums) {\n    let k = 1;  </span><span style=\"font-family: -apple-system, system-ui, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><font color=\"#e74c3c\"><b>// Because first number alwys will be unique </b></font></span><span style=\"font-family: -apple-system, system-ui, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><font color=\"#262626\">\n    for(let i = 1; i &lt; nums.length; i++){\n        if(nums[i] !== nums[i-1]){. </font><b style=\"\"><font color=\"#e74c3c\">// i-1 because compare left beside value </font></b><font color=\"#262626\">\n            nums[k] = nums[i];\n            k++\n        }  \n    }\n    return k\n};</font></span></div></div>",
  "squares-of-a-sorted-array": "<div style=\"color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &quot;Courier New&quot;, monospace; font-size: 13px; line-height: 20px; white-space: pre;\"><div><span style=\"color: #0000ff;\">var</span> <span style=\"color: #795e26;\">sortedSquares</span> = <span style=\"color: #0000ff;\">function</span> (<span style=\"color: #001080;\">nums</span>) {</div><div>    <span style=\"color: #0000ff;\">const</span> <span style=\"color: #0070c1;\">finalResult</span> = <span style=\"color: #0000ff;\">new</span> <span style=\"color: #267f99;\">Array</span>(<span style=\"color: #001080;\">nums</span>.<span style=\"color: #001080;\">length</span>)</div><div>    <span style=\"color: #0000ff;\">let</span> <span style=\"color: #001080;\">left</span> = <span style=\"color: #098658;\">0</span>;</div><div>    <span style=\"color: #0000ff;\">let</span> <span style=\"color: #001080;\">right</span> = <span style=\"color: #001080;\">nums</span>.<span style=\"color: #001080;\">length</span> - <span style=\"color: #098658;\">1</span>;</div><div>    <span style=\"color: #0000ff;\">let</span> <span style=\"color: #001080;\">k</span> = <span style=\"color: #001080;\">nums</span>.<span style=\"color: #001080;\">length</span> - <span style=\"color: #098658;\">1</span>;  // add from last </div><br><div>    <span style=\"color: #af00db;\">while</span> (<span style=\"color: #001080;\">right</span> &gt;= <span style=\"color: #001080;\">left</span>) {</div><div>        <span style=\"color: #0000ff;\">const</span> <span style=\"color: #0070c1;\">leftAbs</span> = <span style=\"color: #267f99;\">Math</span>.<span style=\"color: #795e26;\">abs</span>(<span style=\"color: #001080;\">nums</span>[<span style=\"color: #001080;\">left</span>]);</div><div>        <span style=\"color: #0000ff;\">const</span> <span style=\"color: #0070c1;\">rightAbs</span> = <span style=\"color: #267f99;\">Math</span>.<span style=\"color: #795e26;\">abs</span>(<span style=\"color: #001080;\">nums</span>[<span style=\"color: #001080;\">right</span>]);</div><div>        <span style=\"color: #af00db;\">if</span>(<span style=\"color: #001080;\">leftAbs</span> &gt;= <span style=\"color: #001080;\">rightAbs</span> ){</div><div>            <span style=\"color: #001080;\">finalResult</span>[<span style=\"color: #001080;\">k</span>] = <span style=\"color: #001080;\">leftAbs</span> * <span style=\"color: #001080;\">leftAbs</span>; </div><div>            <span style=\"color: #001080;\">left</span>++</div><div>        } <span style=\"color: #af00db;\">else</span>{</div><div>            <span style=\"color: #001080;\">finalResult</span>[<span style=\"color: #001080;\">k</span>] = <span style=\"color: #001080;\">rightAbs</span> * <span style=\"color: #001080;\">rightAbs</span>;</div><div>            <span style=\"color: #001080;\">right</span>-- </div><div>        }</div><div>        <span style=\"color: #001080;\">k</span>--</div><div>    }</div><div>    <span style=\"color: #af00db;\">return</span> <span style=\"color: #001080;\">finalResult</span></div><div>}</div></div>",
  "move-zeroes": "<span style=\"color: rgb(38, 38, 38); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\">  i/p\nvar moveZeroes = function(nums) {\n    let x = 0;\n    for(i = 0; i &lt; nums.length; i++){\n        if(nums[i] !== 0){\n          nums[x] = nums[i];\n          x++\n        }\n    }\n\n    </span><span style=\"font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><font color=\"#e74c3c\"><b>while(x &lt; nums.length</b></font></span><span style=\"color: rgb(38, 38, 38); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;; font-size: 14px; white-space: pre; background-color: rgb(255, 255, 255);\"><b>)</b>{\n        nums[x] = 0\n        x = x+ 1\n    }\n\n    \n};</span>"
}