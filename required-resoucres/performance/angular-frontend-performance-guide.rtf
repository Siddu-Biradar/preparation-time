\fs38\fsmilli19333 \cf2 \cb3 6.1 Avoid method calls in templates\cb1 \
\pard\pardeftab720\sa200\partightenfactor0

\f2\fs30\fsmilli15200 \cf5 \cb3 \strokec5 Problem:
\f3\b0  Every change detection cycle re-runs the method.\cb1 \
\pard\pardeftab720\partightenfactor0

\f4\fs26\fsmilli13067 \cf5 \cb12 // Bad\
@Component(\{\
  template: `<li *ngFor="let user of filteredUsers()">\{\{ user.name \}\}</li>`\
\})\
export class UsersComponent \{\
  users = LARGE_USER_LIST;\
\
  filteredUsers() \{\
    return this.users.filter(user => user.isActive);\
  \}\
\}\
\
// Better\
@Component(\{\
  template: `<li *ngFor="let user of activeUsers; trackBy: trackById">\{\{ user.name \}\}</li>`\
\})\
export class UsersComponent \{\
  users = LARGE_USER_LIST;\
  activeUsers = this.users.filter(user => user.isActive);\
\
  trackById(_: number, user: \{ id: number \}) \{\
    return user.id;\
  \}\
\}\
\pard\pardeftab720\sa200\partightenfactor0

\f0\b\fs38\fsmilli19333 \cf2 \cb3 \strokec2 6.2 Use OnPush and immutable updates\cb1 \
\pard\pardeftab720\partightenfactor0

\f4\b0\fs26\fsmilli13067 \cf5 \cb12 \strokec5 @Component(\{\
  selector: 'app-cart',\
  changeDetection: ChangeDetectionStrategy.OnPush,\
  template: `\
    <div *ngFor="let item of items; trackBy: trackById">\
      \{\{ item.name \}\} - \{\{ item.qty \}\}\
    </div>\
  `\
\})\
export class CartComponent \{\
  @Input() items: Array<\{ id: number; name: string; qty: number \}> = [];\
\
  trackById(_: number, item: \{ id: number \}) \{\
    return item.id;\
  \}\
\}\
\
// Parent update pattern\
this.items = this.items.map(item =>\
  item.id === targetId ? \{ ...item, qty: item.qty + 1 \} : item\
);\
\pard\pardeftab720\sa200\partightenfactor0

